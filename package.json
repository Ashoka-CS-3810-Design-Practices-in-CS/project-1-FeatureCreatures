{
  "name": "int-calendar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "cross-env TZ=UTC vitest run",
    "test:watch": "cross-env TZ=UTC vitest",
    "test:coverage": "cross-env TZ=UTC vitest run --coverage",
    "test:dst": "cross-env TZ=America/New_York vitest run --config vitest.dst.config.ts",
    "test:props:full": "cross-env TZ=UTC PROP_RUNS=10000 PROP_SEED=random vitest run props",
    "bench": "cross-env TZ=UTC vitest bench --run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/react": "^7.1.3",
    "@fullcalendar/timegrid": "^6.1.22",
    "@hookform/resolvers": "^5.9.2",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
